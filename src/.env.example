# 养鱼免单后端 · 环境变量示例（仅占位，真实密钥勿提交）
PORT=8080
NODE_ENV=development

# MariaDB 连接（联邦站现网 MariaDB 10.11；本地联调用便携版 127.0.0.1:3399）
DB_HOST=127.0.0.1
DB_PORT=3399
DB_USER=root
DB_PASSWORD=
DB_NAME=yangyu_miandan_test

# JWT 签名密钥（生产必须替换为强随机值）
JWT_SECRET=change-me-in-production-please-use-32+chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS 显式来源（生产禁用通配符，逗号分隔）
CORS_ORIGINS=https://ai.ws.hi.cn,http://localhost:8080

# 奖励参数默认值（运营可在后台覆盖）
REWARD_COVERAGE_CAP=1.0
PER_MERCHANT_QUOTA=200
YANGYU_WEEKLY_THRESHOLD=5
