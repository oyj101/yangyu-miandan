# 养鱼免单后端 · 环境变量示例（仅占位，真实密钥勿提交）
PORT=8080
NODE_ENV=development

# MariaDB 连接（联邦站现网 MariaDB 10.11；本地联调用便携版 127.0.0.1:3399）
DB_HOST=127.0.0.1
DB_PORT=3399
DB_USER=root
DB_PASSWORD=
DB_NAME=yangyu_miandan_test

# JWT 签名密钥（生产必须替换为强随机值）
JWT_SECRET=change-me-in-production-please-use-32+chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS 显式来源（生产禁用通配符，逗号分隔）
CORS_ORIGINS=https://ai.ws.hi.cn,http://localhost:8080

# 奖励参数默认值（运营可在后台覆盖）
REWARD_COVERAGE_CAP=1.0
PER_MERCHANT_QUOTA=200
YANGYU_WEEKLY_THRESHOLD=5

# v2 套餐卡
YANGYU_STREAK_DAYS=5
YANGYU_REFUND_RATIO_NOW=0.7
YANGYU_REFUND_RATIO_SHARE=0.3
# 供应价率红线（c ≤ 0.3 时达标未分享净额 ≥ 0）
YANGYU_SUPPLY_RATIO_MAX=0.3
# 新卡的缺省分享分成（逐卡可在 card.share_ratio 覆盖；已售期次走 period 快照不随此值变动）
YANGYU_SHARE_RATIO=0.3
# 单卡分享分成上限（0~1；仍需满足 (1-r)×P ≥ C，否则建卡被拒）
YANGYU_SHARE_RATIO_MAX=0.5
# 分享解锁范围：all=该分享者名下全部卡（默认，2026-10-21 PO 口径）；card=只解锁被分享那张
SHARE_UNLOCK_SCOPE=all
# 绑定即解锁：true=朋友打开链接就解锁（PO 口径）；false=退回「必须成交」
SHARE_UNLOCK_ON_BIND=true
# 归因策略：first=首触锁定（默认，一个被分享者只归一任分享者）；last=末触覆盖
SHARE_BIND_POLICY=first
# 主站推荐关系兜底（默认关；开启后 zy_users 关系仍可触发解锁，注意双口径重复发钱风险）
SHARE_FALLBACK_REFERRER=false

# 分享落地（主站关系链契约：路径与参数名必须与主站一致，改这里不用发版）
SHARE_LINK_TEMPLATE=https://ai.ws.hi.cn/yangyu?ref={ref}
SHARE_REF_PARAM=ref
SHARE_CHAIN_TIMEOUT_MS=1500

# 埋点保留期（天）
SDK_TRACK_RETENTION_DAYS=90

# ─────────────────────────── 租户上下文（007 tenant 表） ───────────────────────────
# 三档：
#   off    = 完全不解析（回滚开关，等于回到单租户）
#   shadow = 解析并挂 req.tenant；该拒的只告警不拒（默认，先观测命中率）
#   strict = 推导不出 / 来源冲突 / 租户下线 → 403 fail-closed
# 切换顺序必须是 shadow → 观察 zy 日志 tenant_shadow_would_reject → strict
TENANT_ENFORCE=shadow
# 内部调用（运维脚本、本机 curl）无法从域名推导时的缺省租户码；留空则内部调用也拒
TENANT_DEFAULT_CODE=
# 域名 → 租户码，JSON。覆盖别名域/自定义域；一级子域（xxx.ws.hi.cn）无需登记，自动推导
# TENANT_DOMAIN_MAP={"ai.ws.hi.cn":"ai","h6.ws.hi.cn":"h6","shop.mica178.com":"yx"}
# 平台自用域（控制台/运维），不归属任何租户
TENANT_PLATFORM_HOSTS=ws.hi.cn,www.ws.hi.cn
# 允许自动推导的一级子域后缀
TENANT_SUBDOMAIN_SUFFIXES=ws.hi.cn
# tenant 表查询缓存（改库后最多延迟一个 TTL 生效）
TENANT_CACHE_TTL_MS=60000
TENANT_CACHE_MAX=200
# 额外可信代理地址（回环/10./192.168./172.16-31. 已内置，这里只补特殊 IP）
TENANT_TRUSTED_PROXIES=
